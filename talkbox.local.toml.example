# Per-machine settings, merged over talkbox.toml. Never committed (.gitignore).
# Copy to talkbox.local.toml and uncomment only the keys that differ on this machine.
#
#     cp talkbox.local.toml.example talkbox.local.toml
#
# Sections merge key by key, so setting one value leaves the rest of that section alone.
# Leave the [section] headers below as they are: a key without its header lands at the
# top level of the file, where nothing reads it.

# --- Raspberry Pi with the button and status LED (docs/hardware.md) ---
[voice]
# button_gpio = 17
# led_gpio = [22, 23, 24]
# led_common_anode = true
# Audio devices, if the system default is wrong. Use a name from
# `scripts/mic_check.py` or `python -m sounddevice` on THIS machine -- the names differ
# per machine, and one that matches nothing stops talkbox talk with an error.
# input_device = "<a name from the list on this machine>"

# --- the Pi's picture screen (docs/hardware.md) ---
# Only the Pi has one, so this is the machine that turns it on. Everything else in
# [screen] has a sensible default in talkbox.toml.
[screen]
# enabled = true
# timeout_seconds = 3
# 90/270 = landscape (the default), 0/180 = portrait. Use whichever matches how the
# panel ended up in the enclosure -- screen_check.py's blue square marks the top left.
# rotation = 90
# The backlight pin, if it's on a GPIO rather than 3V3 (docs/hardware.md).
# backlight_gpio = 12
# backlight_active_high = true

# --- a machine that needs a fixed web address ---
[web]
# host = "192.168.1.20"

# --- a slower machine that needs a longer deadline for the classifier ---
[guardrails.classifier]
# timeout_seconds = 9
