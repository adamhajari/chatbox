# The model vendor in chatbox.toml's [provider] name needs its key: openai (default) or anthropic.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Voice (chatbox talk): Google Cloud service-account key file (keep it outside the repo)
GOOGLE_APPLICATION_CREDENTIALS=/Users/you/.config/chatbox/gcp-speech.json
GOOGLE_CLOUD_PROJECT=your-project-id
